# TRISK Docker Environment Variables
# Copy this to .env and customize for your deployment

# --- Caddy reverse proxy ---
# Username for HTTP Basic Auth (default: analyst)
TRISK_USER=analyst
# Password hash — REQUIRED, Caddy will not start without it. Generate with:
#   docker run --rm caddy:2.10.2-alpine caddy hash-password --plaintext 'YourPassword'
# Keep the single quotes: the hash contains '$', which compose would otherwise
# treat as variable references and silently corrupt (every login then fails).
# Example: TRISK_PASS_HASH='$2a$14$...'
TRISK_PASS_HASH=

# --- Base image override (for bank Artifactory) ---
# BASE_IMAGE=artifactory.bank.com/approved/r-ver:4.4.1@sha256:...

# --- Shiny settings ---
SHINY_LOG_LEVEL=WARN

# --- Debug mode (set to true to enable verbose analysis logging in UI) ---
TRISK_DEBUG_LOG=false
