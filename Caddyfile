{
    # No automatic HTTPS (use manual certs for bank deployment)
    auto_https off
}

:443 {
    # TLS — mount your bank-issued cert + key into /etc/caddy/certs/
    tls /etc/caddy/certs/cert.pem /etc/caddy/certs/key.pem

    # Security headers
    header {
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ws: wss:; frame-ancestors 'none'"
        Strict-Transport-Security "max-age=63072000; includeSubDomains"
        -Server
    }

    # HTTP Basic Auth — set TRISK_USER / TRISK_PASS_HASH in .env (see .env.example).
    # No fallback hash: Caddy refuses to start if TRISK_PASS_HASH is empty.
    basic_auth {
        {$TRISK_USER:analyst} {$TRISK_PASS_HASH}
    }

    reverse_proxy trisk:3838
}
